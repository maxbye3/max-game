{
  "name": "max-game",
  "version": "1.0.6",
  "private": true,
  "description": "Max's Overworld - a browser overworld game",
  "scripts": {
    "build:site": "node scripts/build.mjs --site",
    "build": "node scripts/build.mjs",
    "prepare:web-assets": "node scripts/prepare-web-assets.mjs && python3 scripts/prepare-web-fonts.py && node scripts/generate-source.mjs web-assets styles",
    "clean:dist": "node scripts/clean-dist.mjs",
    "bundle": "node scripts/generate-source.mjs && node scripts/bundle.mjs",
    "extend:internal-collision": "node scripts/extend-internal-collision.mjs && npm run generate:internal-collision",
    "generate:internal-collision": "node scripts/generate-source.mjs internal-collision",
    "generate:typescript": "node scripts/generate-source.mjs",
    "generate:source": "node scripts/generate-source.mjs",
    "generate:dialogues": "node scripts/generate-source.mjs dialogues",
    "generate:profiles": "node scripts/generate-source.mjs profiles",
    "generate:dialogue-themes": "node scripts/generate-source.mjs dialogue-themes",
    "generate:battle-avatars": "node scripts/generate-source.mjs battle-avatars",
    "generate:bookshop-npcs": "node scripts/generate-bookshop-npcs.mjs",
    "generate:map-character-sprites": "node scripts/generate-map-character-sprites.mjs",
    "optimize:internal-assets": "node scripts/optimize-internal-assets.mjs",
    "sync:goodreads": "node scripts/sync-goodreads-read.mjs",
    "sync:letterboxd": "node scripts/sync-letterboxd-reviews.mjs",
    "watch": "node scripts/generate-source.mjs && node scripts/bundle.mjs --watch",
    "test": "node scripts/run-tests.mjs",
    "typecheck": "node scripts/generate-source.mjs && tsc --noEmit",
    "check:dialogues": "node scripts/check-dialogues.mjs",
    "sync:photos": "node scripts/sync-google-photos.mjs",
    "sync:content": "node scripts/sync-content.mjs",
    "test:dialogue": "node scripts/run-tests.mjs dialogue journals niall",
    "test:powers": "node scripts/run-tests.mjs powers",
    "test:progression": "node scripts/run-tests.mjs progression traffic interiors",
    "test:assets": "node scripts/run-tests.mjs assets sprites entries profiles",
    "test:content": "node scripts/run-tests.mjs content",
    "test:tooling": "node scripts/run-tests.mjs tooling",
    "test:browser": "node scripts/test-browser.mjs",
    "test:controls": "node scripts/run-tests.mjs controls",
    "generate:styles": "node scripts/generate-source.mjs styles"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "playwright": "^1.64.1",
    "typescript": "^5.9.2"
  }
}
