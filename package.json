{
  "name": "max-game",
  "version": "1.0.0",
  "private": true,
  "description": "Max's Overworld - a browser overworld game",
  "scripts": {
    "build": "tsc && npm run bundle",
    "bundle": "esbuild js/main.ts js/internal.ts --bundle --outdir=dist --entry-names=[name]-bundle --format=iife",
    "generate:internal-collision": "node scripts/generate-internal-collision.mjs",
    "watch": "esbuild js/main.ts js/internal.ts --bundle --outdir=dist --entry-names=[name]-bundle --format=iife --watch",
    "watch:bundle": "esbuild js/main.ts js/internal.ts --bundle --outdir=dist --entry-names=[name]-bundle --format=iife --watch",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "typescript": "^5.9.2"
  }
}
